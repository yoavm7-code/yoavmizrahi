{
  "name": "yoavmizrahi-tests",
  "private": true,
  "description": "Tests for the portfolio. Never deployed. See README.md (Tests).",
  "type": "module",
  "scripts": {
    "test": "node --test \"unit/*.test.mjs\" \"../worker/test/*.test.js\"",
    "test:browser": "node ../tools/build-site.mjs && playwright test",
    "test:all": "npm test && npm run test:browser",
    "record:demos": "node ../tools/build-site.mjs && node record-demos.mjs",
    "share:images": "node ../tools/build-site.mjs && node share-images.mjs",
    "posters": "node posters.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1"
  }
}
